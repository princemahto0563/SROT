# SROT — Source Tracing & Recapture Origin Toolkit
# Environment Configuration (Optional)
# SROT is a local-first, offline forensic toolkit. No external API keys or cloud services required.

# Server & Network Configuration
SROT_BACKEND_PORT=8077
SROT_FRONTEND_PORT=5177
SROT_API=http://127.0.0.1:8077

# Data Directory Override (Defaults to ./data)
# SROT_DATA=/path/to/custom/data

# Custom Font Path for Synthetic Benchmark Generation (Optional)
# SROT_FONT=/System/Library/Fonts/Supplemental/Arial.ttf

# Offline Enforcement (Recommended for air-gapped forensic environments)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Police Officer Authentication Gate (Optional Configuration)
# Default demo credentials automatically seeded for offline evaluation:
DEMO_OFFICER_BADGE=DEMO-OFFICER
DEMO_OFFICER_PASSWORD=Forensic#2026!SecOps
DEMO_OFFICER_NAME="Insp. Vikramaditya (Cyber Ops)"
DEMO_OFFICER_ROLE="Senior Forensic Investigator"
DEMO_OFFICER_UNIT="Cyber Crime Investigation Unit"

