# SROT — Source Tracing & Recapture Origin Toolkit
# Environment Configuration (Template)
# SROT is a local-first, offline-capable forensic toolkit.

# ── Backend Configuration (Render / Local) ───────────────────────────────────
# Server & Network Ports
PORT=8077
SROT_BACKEND_PORT=8077
SROT_FRONTEND_PORT=5177

# Allowed CORS Origins (comma-separated, no wildcard in production)
CORS_ORIGINS=http://localhost:5177,http://127.0.0.1:5177,https://your-frontend.vercel.app

# Persistent Storage Directory (Mount Render persistent disk at /var/data)
SROT_DATA=/var/data

# Offline Enforcement (Ensures neural ViT and Hugging Face run offline)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Police Officer Authentication Gate
# Set an evaluation password for the demo officer account.
# IMPORTANT: Never commit actual passwords to git or embed in frontend.
DEMO_OFFICER_BADGE=DEMO-OFFICER
DEMO_OFFICER_PASSWORD=your_secure_evaluator_password_here
DEMO_OFFICER_NAME="Insp. Vikramaditya (Cyber Ops)"
DEMO_OFFICER_ROLE="Senior Forensic Investigator"
DEMO_OFFICER_UNIT="Cyber Crime Investigation Unit"

# ── Frontend Configuration (Vercel) ──────────────────────────────────────────
# Point to your deployed Render service API base (do not include trailing slash)
# VITE_API_URL=https://your-render-service.onrender.com/api
